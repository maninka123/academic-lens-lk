# Environment variables for Scholar Scraper and Enrichment Suite

# OpenAlex API Key (raises rate limit to 10 req/s and 10,000 queries/day)
OPENALEX_API_KEY=your_openalex_api_key_here

# SerpApi API Key (optional, for fast and CAPTCHA-free Google Scholar scraping)
SERPAPI_API_KEY=your_serpapi_api_key_here
